{
  "name": "jumper",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter playground dev",
    "docs": "bun --filter docs dev",
    "build": "bun --filter playground build",
    "build:site": "bun scripts/build-site.ts",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "check": "biome check .",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun --filter jumper-cli build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "3.0.3",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
